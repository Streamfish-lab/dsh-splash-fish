{
  "name": "dsh-splash-fish",
  "version": "0.3.0",
  "description": "Depth-driven 2.5D startup film for DeepSeek Harness: a host-side boot cover removes the native splash flash, then the artwork develops out of the dark with parallax motion and dissolves into the workspace.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "python3 build.py",
    "check": "node --check client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "splash",
    "boot-animation"
  ],
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "assets/splash.webp",
    "client.template.js",
    "build.py",
    "preview.html",
    "dev/harness.html",
    "README.md"
  ]
}
